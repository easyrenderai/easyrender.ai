{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VERCEL_ENV",
        "REPLICATE_API_TOKEN",
        "HARNESS_GITHUB_TOKEN",
        "BETTER_AUTH_*",
        "STRIPE_*",
        "S3_BUCKET",
        "ASSETS_CDN_URL",
        "AWS_REGION",
        "AWS_ROLE_ARN",
        "EXPORTS_*",
        "MODEL_EXPORT_FUNCTION",
        "NEXT_PUBLIC_*",
        "SENTRY_*",
        "SHOPIFY_*",
        "APP_URL",
        "SHEET_ENABLED",
        "FREE_PREVIEWS_PER_DAY",
        "ADMIN_EMAILS",
        "ANALYTICS_EXCLUDE_EMAILS",
        "ANALYTICS_TZ",
        "POSTHOG_PERSONAL_API_KEY",
        "POSTHOG_PROJECT_ID",
        "PRICING_AB_ENABLED",
        "EUR_CHECKOUT_DISABLED",
        "PRICING_AB_E2E",
        "PRICING_E2E_URL",
        "POSTHOG_API_HOST",
        "STRIPE_ANALYTICS_KEY",
        "POSTHOG_HOST",
        "ANALYTICS_LOCAL_TEST",
        "GA_MEASUREMENT_ID",
        "GA_MEASUREMENT_API_SECRET",
        "CRON_SECRET",
        "EMAIL_ONBOARDING_ENABLED",
        "RESEND_API_KEY",
        "RESEND_WEBHOOK_SECRET",
        "EMAIL_TOKEN_SECRET",
        "EMAIL_FROM",
        "EMAIL_REPLY_TO",
        "EMAIL_LEGAL_IDENTITY",
        "EMAIL_ALLOWED_RECIPIENTS",
        "SERVICE_EMAIL_ENABLED",
        "SERVICE_EMAIL_ENCRYPTION_SECRET"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": ["TEST_DATABASE_URL"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
