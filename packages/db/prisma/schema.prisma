generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth ─────────────────────────────────────────────

model User {
  // First-touch attribution. Nullable, additive, never overwritten.
  utm_source String?
  utm_medium String?
  utm_campaign String?
  utm_content String?
  utm_term String?
  referrer String?
  landing_path String?
  first_seen_at String?
  geo_country String?
  consent_region_at_create String?

  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  credits       Int      @default(0)
  stripeCustomerId   String? @unique
  subscriptionId     String? @unique
  subscriptionStatus String?
  subscriptionPlan   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  emailSubscription EmailSubscription?
  serviceEmailDeliveries ServiceEmailDelivery[]

  sessions  Session[]
  accounts  Account[]
  renders   Render[]
  ledger    CreditLedger[]
  purchases Purchase[]
  googleCheckouts GoogleCheckout[]
  posthogDeliveries PosthogDelivery[]
  apiKeys   ApiKey[]
  catalogItems CatalogItem[]
  shopifyShops ShopifyShop[]
  viewSets  ViewSet[]
  libraryFolders LibraryFolder[]
  upscales  Upscale[]
  firstModelEnrollment FirstModelEnrollment?

  // Referral program: a lazily issued share code, and the referral that brought this user in.
  referralCode      String?    @unique
  referralsMade     Referral[] @relation("ReferralReferrer")
  referralReceived  Referral?  @relation("ReferralReferred")

  @@map("user")
}

// One row per new account that signed up through a referral link. referredUserId is unique, so a
// new account can bring in at most one reward. Credits move through the ledger, keyed by this id.
model Referral {
  id             String    @id @default(cuid())
  code           String
  referrerId     String
  referrer       User      @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String    @unique
  referred       User      @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  // pending: waiting for the new user's email. rewarded: credits granted. rejected: abuse check.
  status         String    @default("pending")
  rejectReason   String?
  referrerCredits Int      @default(0)
  referredCredits Int      @default(0)
  createdAt      DateTime  @default(now())
  rewardedAt     DateTime?

  @@index([referrerId, status])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── App ─────────────────────────────────────────────────────

// One bounded pilot. Pausing stops enrollment, never cancels an existing offer.
model FirstModelCampaign {
  id String @id
  isActive Boolean @default(false)
  maxOffers Int
  startedAt DateTime @default(now())
  endsAt DateTime
  enrolled Int @default(0)
  nextVariant String?
  enrollments FirstModelEnrollment[]
}

model FirstModelEnrollment {
  id String @id @default(cuid())
  campaignId String
  campaign FirstModelCampaign @relation(fields: [campaignId], references: [id])
  anonId String @unique
  userId String? @unique
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // A deleted account must not make its anonymous reservation redeemable again.
  boundAt DateTime?
  ipHash String
  variant String
  pricingVariant String
  enrolledAt DateTime @default(now())
  grantedAt DateTime?
  grantRenderId String? @unique
  grantCredits Int @default(0)

  @@index([campaignId, enrolledAt])
  @@index([ipHash, enrolledAt])
}

enum RenderStatus {
  drafting
  preview_ready
  rendering
  ready
  failed
}

model Render {
  // First-touch attribution. Nullable, additive, never overwritten.
  utm_source String?
  utm_medium String?
  utm_campaign String?
  utm_content String?
  utm_term String?
  referrer String?
  landing_path String?
  first_seen_at String?
  geo_country String?
  consent_region_at_create String?

  id                String       @id @default(cuid())
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Visitors get a free preview before signing up; the anon cookie ties it to them.
  anonId            String?
  ipHash            String?
  // Language chosen in the product, independent of attribution consent.
  notificationLocale String?
  prompt            String?
  // Display name for catalog items, usually the uploaded file name.
  name              String?
  status            RenderStatus @default(drafting)
  sourceKey         String
  sourceUrl         String?
  // Idempotent creation is scoped to a user (or anonymous visitor), never an API token.
  requestScope      String?
  requestKey        String?
  requestHash       String?
  // Throttles status polling without changing the generation's updatedAt deadline.
  pollAfter         DateTime?
  sheetKey          String?
  glbKey            String?
  // Material changes made by the owner, as a list of { index, baseColor?, roughness?, metalness? }
  // by glTF material. The stored GLB is never rewritten: the edits are applied when it is served.
  materialEdits     Json?
  // What the guardrails measured at each stage (photo, draft sheet, final sheet, model), for
  // comparing quality across renders. Never read to decide anything; see render-quality.ts.
  quality           Json?
  // What the owner asked to fix in the angle sheet, and how many redraws they have paid for. The
  // note joins the prompt in every later sheet, including the final one of the paid build.
  sheetNote         String?
  sheetRedraws      Int          @default(0)
  sheetPredictionId String?      @unique
  buildPredictionId String?      @unique
  // A paid build redraws the sheet with the final model before the 3D build; this is that prediction.
  finalSheetPredictionId String? @unique
  // True when the sheet is already the final 2K sheet (it came from a product views set), so the
  // paid build skips the redraw and only charges for the 3D step.
  hasFinalSheet     Boolean      @default(false)
  // Set by whichever call starts the 3D build, so webhook and polling cannot start it twice.
  buildClaimedAt    DateTime?
  costUsd           Float        @default(0)
  credits           Int          @default(0)
  error             String?
  // Finished renders show in the public gallery unless the owner hides them.
  isPublic          Boolean      @default(false)
  // A store embeds the model on its own product pages: anyone with the link can view it, but it
  // stays out of the public gallery unless isPublic is also true.
  isLinkShared      Boolean      @default(false)
  // Where the render was started: "web" (the app), "mcp" (an agent) or "api" (REST with a key).
  source            String       @default("web")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // Immutable successful GLB completion; null for historical rows with no observed time.
  completedAt       DateTime?
  previewCompletedAt DateTime?
  edits             RenderEdit[]
  // The library folder the owner filed this render in. Null is unfiled; deleting a folder unfiles.
  folderId          String?
  folder            LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([requestScope, requestKey])
  @@index([userId, createdAt])
  @@index([userId, folderId])
  @@index([anonId, createdAt])
  @@index([ipHash, createdAt])
  @@index([isPublic, status, createdAt])
  @@index([completedAt, id])
  @@index([previewCompletedAt, id])
}

// A flat folder in a person's library. Names are unique per owner. Deleting a folder keeps its
// renders and unfiles them.
model LibraryFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  renders   Render[]

  @@unique([userId, name])
  @@index([userId])
}

// What the owner did to a render after the free preview, newest last: the angle sheet drawn, a
// redraw with its note, the 3D build, a material change. One row per paid or saved step, written
// when the step starts, so the History tab on the render page can list them. A render made
// before this table existed simply has none.
model RenderEdit {
  id        String   @id @default(cuid())
  renderId  String
  render    Render   @relation(fields: [renderId], references: [id], onDelete: Cascade)
  // sheet | sheet_redraw | build | material
  kind      String
  // The owner's words for a redraw; null for the rest.
  note      String?
  // What the step cost. Zero for a material change.
  credits   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([renderId, createdAt])
}

// Product views: one photo in, nine packshots out on white, with no 3D build. A set is paid for
// when it is created; its views can be polished one by one afterwards.
enum ViewSetStatus {
  drafting
  processing
  ready
  failed
}

enum ProductViewStatus {
  drawing
  upscaling
  ready
}

model ViewSet {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String?
  prompt            String?
  status            ViewSetStatus @default(drafting)
  sourceKey         String
  sourceUrl         String?
  // The 3x3 sheet the views were cut from, and how many sheets were drawn (one automatic retry).
  sheetKey          String?
  sheetPredictionId String?       @unique
  sheetAttempts     Int           @default(1)
  // What the guardrails measured on the sheet and on each view, for comparing quality over time.
  quality           Json?
  credits           Int           @default(0)
  costUsd           Float         @default(0)
  error             String?
  // The 3D render made from these views, once the owner chose to build one.
  renderId          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  views             ProductView[]

  @@index([userId, createdAt])
}

model ProductView {
  id           String            @id @default(cuid())
  setId        String
  set          ViewSet           @relation(fields: [setId], references: [id], onDelete: Cascade)
  // One of the nine sheet positions: front, front_right, ..., top.
  view         String
  status       ProductViewStatus @default(drawing)
  // Durable processing lease; provider ids survive temporary download failures.
  advanceAfter DateTime?
  // The finished packshot (white background, fixed canvas). Empty until the first one is made.
  key          String?
  // The drawn view before it was upscaled and finished.
  rawKey       String?
  predictionId String?           @unique
  // Redraws tried for this stage; the automatic ones stop at the harness limit.
  attempts     Int               @default(0)
  // What the owner asked to fix, and how many polishes they have paid for.
  note         String?
  polishes     Int               @default(0)
  // True while the current stage is a paid polish, so a failed one is refunded and reverted.
  isPolishing  Boolean           @default(false)
  // The checks that ran on the current picture: the problems found, if any.
  qa           Json?
  version      Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([setId, view])
}

// A paid enlargement of one picture the owner already has: a product view, or the angle sheet of
// a paid render. The original is never touched; the larger file is stored beside it.
enum UpscaleStatus {
  processing
  ready
  failed
}

model Upscale {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // view | sheet
  kind         String
  // The render (sheet) or the views set and view name (view) it was made from.
  renderId     String?
  viewSetId    String?
  view         String?
  status       UpscaleStatus @default(processing)
  sourceKey    String
  // The enlarged picture, once there is one.
  key          String?
  predictionId String?       @unique
  scale        Int
  width        Int?
  height       Int?
  credits      Int
  costUsd      Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([renderId])
  @@index([viewSetId, view])
}

model CreditLedger {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta      Int
  reason     String
  // One spend and one refund per render, one grant per purchase.
  idempotencyKey String @unique
  renderId   String?
  purchaseId String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId String   @unique
  packId          String
  credits         Int
  amountCents     Int
  currency        String   @default("usd")
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?
  googleDelivery GooglePurchaseDelivery?
  @@index([paidAt, id])
}

model ImageUpload {
  id          String   @id @default(cuid())
  userId      String
  sourceKey   String
  contentType String
  size        Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model ApiRateWindow {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  // OAuth keys are bound to this easyrender service; manual and existing keys remain unscoped.
  resource   String?
  scopes     String[]  @default(["read", "write", "spend", "share"])
  creditLimit Int?
  spentCredits Int     @default(0)
  expiresAt  DateTime?

  @@index([userId])
}

// A consumed authorization code must stay consumed even after its API key is revoked.
// Only a digest is stored, never the code, verifier or access token.
model OAuthCodeRedemption {
  codeHash  String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// One product of a connected store (Shopify, WooCommerce, ...) that is turned into a 3D model.
// A plugin sends its products; the server walks each one from photo to finished model.
model CatalogItem {
  id         String   @id @default(cuid())
  apiKeyId   String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  // The shop's domain or the site's host: one account can connect several stores.
  store      String
  // The product's id on the platform.
  externalId String
  title      String
  imageUrl   String
  note       String?
  renderId   String?
  // queued | drafting | building | ready | needs_credits | needs_info | failed
  state      String   @default("queued")
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, platform, store, externalId])
  @@index([userId, platform, store, state])
  @@index([renderId])
}

// A Shopify store that installed the app. The merchant links it to an easyrender account, which pays
// for the models. The Admin API token is stored encrypted (see packages/core/src/shopify.ts).
model ShopifyShop {
  // The shop's permanent domain, e.g. my-store.myshopify.com.
  shop        String   @id
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessToken String
  scope       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Consent-scoped linkage for a single checkout; never sent to Stripe as metadata.
model GoogleCheckout {
  id          String @id
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  sessionId   String
  adMeasurementAllowed Boolean @default(false)
  invoiceId   String? @unique
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  delivery    GooglePurchaseDelivery?
  @@index([userId])
}

// Durable purchase outbox. Its stable transaction ID also deduplicates uncertain network retries.
model GooglePurchaseDelivery {
  purchaseId  String @id
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  checkoutId  String @unique
  checkout    GoogleCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  attempts    Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  deliveredAt DateTime?
  lastError   String?
  @@index([deliveredAt, nextAttemptAt])
}

// Business events are immutable after enqueue; no emails, prompts or source URLs are stored.
model PosthogDelivery {
  id            String @id
  userId        String?
  user          User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         String
  distinctId    String
  subjectId     String @default("")
  alias         String?
  properties    Json
  occurredAt    DateTime
  createdAt     DateTime @default(now())
  attempts      Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil    DateTime?
  leaseToken    String?
  deliveredAt   DateTime?
  deadAt        DateTime?
  lastError     String?
  @@index([deliveredAt, deadAt, nextAttemptAt])
  @@index([event, subjectId])
  @@index([userId])
}

model AdvertisingSpend {
  id           String @id @default(cuid())
  date         DateTime @db.Date
  platform     String @default("google_ads")
  accountId    String
  campaignId   String
  campaignName String
  currency     String
  costCents    Int
  clicks       Int
  impressions  Int
  importedAt   DateTime @default(now())
  @@unique([platform, accountId, campaignId, date, currency])
  @@index([date])
}

// Voluntary commercial onboarding only; no enrollment inferred from analytics consent.
model EmailSubscription {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String
  locale String
  route String
  timezone String
  status String @default("pending")
  consentVersion String
  consentNonce String
  unsubscribeNonce String
  requestedAt DateTime
  confirmExpiresAt DateTime
  confirmedAt DateTime?
  expiresAt DateTime
  isPaused Boolean @default(false)
  nextCheckAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries EmailDelivery[]
  events EmailConsentEvent[]
  @@index([status, nextCheckAt])
}
model EmailConsentEvent {
  id String @id @default(cuid())
  subscriptionId String
  subscription EmailSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event String
  version String
  occurredAt DateTime @default(now())
  @@index([subscriptionId, occurredAt])
}
model EmailDelivery {
  id String @id @default(cuid())
  subscriptionId String
  subscription EmailSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind String
  messageKey String
  status String @default("pending")
  payload Json
  recipient String
  consentNonce String
  expiresAt DateTime
  firstAttemptAt DateTime?
  lastAttemptAt DateTime?
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  providerId String? @unique
  acceptedAt DateTime?
  deliveredAt DateTime?
  bouncedAt DateTime?
  complainedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@unique([subscriptionId, kind, messageKey])
  @@index([status, nextAttemptAt])
}

// Authenticated provider facts are retained without message bodies or recipient PII.
// They may arrive before the send response supplies providerId to EmailDelivery.
model EmailProviderEvent {
  id String @id
  providerId String
  type String
  occurredAt DateTime
  receivedAt DateTime @default(now())
  @@index([providerId, occurredAt])
}

// Service messages are independent of promotional consent. Auth payloads are encrypted.
model ServiceEmailDelivery {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  dedupeKey String @unique
  email String
  locale String @default("en")
  renderId String?
  payloadEncrypted String?
  status String @default("queued")
  attempts Int @default(0)
  firstAttemptAt DateTime?
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  providerId String? @unique
  acceptedAt DateTime?
  deliveredAt DateTime?
  expiresAt DateTime
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
  @@index([userId, purpose])
  @@index([email, firstAttemptAt])
}

model ServiceEmailSuppression {
  email String @id
  reason String
  createdAt DateTime @default(now())
}
