{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run vercel-build",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/renders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/analytics",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/email",
      "schedule": "*/15 * * * *"
    }
  ]
}
